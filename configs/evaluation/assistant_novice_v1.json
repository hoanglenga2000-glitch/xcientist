      "required_tools": ["verified_context"],
      "minimum_answer_chars": 300,
      "maximum_answer_chars": 4500,
      "checks": [
        {"check_id": "baseline_metric", "dimension": "evidence_grounding", "weight": 15, "any_of": ["0.9225", "0.2397", "0.2952"]},
        {"check_id": "no_training_carryover", "dimension": "claim_integrity", "weight": 15, "regex_any": ["(?:不会|未|没有|不|不要).{0,8}训练"]},
        {"check_id": "no_submission_carryover", "dimension": "claim_integrity", "weight": 15, "regex_any": ["(?:不会|未|没有|不|不要).{0,12}(?:提交|Kaggle)"]},
        {"check_id": "bounded_plan", "dimension": "actionability", "weight": 15, "regex_any": ["(?:最多|不超过|先做|优先).{0,30}(?:方向|步骤|实验|改进)", "(?:方向|步骤)一"]},
        {"check_id": "controlled_comparison", "dimension": "scientific_rigor", "weight": 15, "regex_any": ["(?:单变量|相同分组|同一分组|固定基线|一次只改|其他.{0,12}不变)"]},
        {"check_id": "promotion_gate", "dimension": "scientific_rigor", "weight": 15, "regex_any": ["(?:晋升|门槛|只有当|才算|才进入|停止|回滚)"]},
        {"check_id": "copyable_followup", "dimension": "novice_clarity", "weight": 10, "any_of": ["直接复制", "直接发这句话", "可以复制"]}
      ],
      "forbidden_any": ["house_prices", "SalePrice", "http://localhost"],
      "forbidden_regex": ["\\.\\.\\."]
    }
