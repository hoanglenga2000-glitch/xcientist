ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_FILE=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_CODE_MODEL=sonnet

DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
# Local-first default. The installer discovers/starts a bundled gateway when
# present; without one, Assistant remains usable through deterministic fallback.
OPENAI_BASE_URL=http://127.0.0.1:65068/v1
OPENAI_MODEL=gpt-5.6-sol
WORKSTATION_LOCAL_FALLBACK=1

# Evolution engine LLM routing: which provider leads, which is fallback.
EVOLUTION_PRIMARY_PROVIDER=openai
EVOLUTION_FALLBACK_PROVIDER=deepseek
EVOLUTION_PROVIDER_STRICT=0

# Local workstation runtime. install.ps1 writes concrete values to the local
# untracked .env; the release template intentionally contains no machine path.
WORKSTATION_HOST=127.0.0.1
WORKSTATION_PORT=8088
WORKSTATION_ROOT=
WORKSTATION_DATA_DIR=
WORKSTATION_PYTHON=
DATABASE_URL=

GPU_SSH_HOST=
GPU_SSH_PORT=22
GPU_SSH_USER=
GPU_SSH_PASSWORD=
GPU_SSH_PASSWORD_FILE=
GPU_SSH_KEY_PATH=
GPU_SSH_KEY_PATH_FILE=
GPU_SSH_KNOWN_HOSTS_PATH=
GPU_SSH_KNOWN_HOSTS_PATH_FILE=
GPU_SSH_SOCKS_HOST=
GPU_SSH_SOCKS_PORT=1080
GPU_SSH_SOCKS_USER=
GPU_SSH_SOCKS_USER_FILE=
GPU_SSH_SOCKS_PASSWORD=
GPU_SSH_SOCKS_PASSWORD_FILE=
GPU_REMOTE_WORKSPACE=
WORKSTATION_SECRET_DIR=

KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_USERNAME_FILE=
KAGGLE_KEY_FILE=

# install.ps1 writes the local SQLite file URL into the untracked .env.
