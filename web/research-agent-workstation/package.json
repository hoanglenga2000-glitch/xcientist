{
  "name": "research-agent-workstation",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 8088",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 8088",
    "start:docker-port": "next start --hostname 0.0.0.0 --port 3090",
    "lint": "oxlint --ignore-pattern=src/components/workstation/Screens.tsx --deny-warnings src scripts",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"src/**/*.test.ts\" \"src/**/*.test.mjs\"",
    "test:report-contract": "uv run --frozen python ../../scripts/run_authenticated_web_contract.py --suite report",
    "test:upgrade-campaign": "node scripts/verify-upgrade-campaign-contract.mjs",
    "smoke:sdk": "node scripts/smoke-claude-sdk.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "audit:prod": "npm audit --omit=dev --audit-level=low --registry=https://registry.npmjs.org",
    "audit:all": "npm audit --audit-level=low --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@prisma/client": "^6.19.3",
    "@xyflow/react": "12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.4",
    "oxlint": "1.76.0",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.4"
  }
}
